<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teacher Dashboard</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="topbar">
    <div>
      <h2>Teacher Dashboard - <%= teacher.standard_name %></h2>
      <p class="top-sub">Subject: <%= teacher.subject %></p>
    </div>
    <form method="post" action="/logout"><button type="submit">Logout</button></form>
  </header>

  <main class="container">
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <section class="card">
      <h3>Mark Daily Attendance</h3>
      <form method="get" action="/teacher" class="filter-row">
        <div>
          <label>Select Date</label>
          <input type="date" name="date" value="<%= selectedDate %>" />
        </div>
        <div>
          <label>&nbsp;</label>
          <button type="submit">Load</button>
        </div>
      </form>

      <form method="post" action="/teacher/attendance/save">
        <input type="hidden" name="date" value="<%= selectedDate %>" />
        <div class="table-wrap">
          <table>
            <thead><tr><th>Roll</th><th>Student Name</th><th>Status</th></tr></thead>
            <tbody>
            <% if (!students.length) { %>
              <tr><td colspan="3">No students assigned.</td></tr>
            <% } %>
            <% students.forEach(s => { const status = attendanceMap[s.id] || "present"; %>
              <tr>
                <td><%= s.roll_no %></td>
                <td><%= s.name %></td>
                <td>
                  <select name="status_<%= s.id %>">
                    <option value="present" <%= status === "present" ? "selected" : "" %>>Present</option>
                    <option value="absent" <%= status === "absent" ? "selected" : "" %>>Absent</option>
                  </select>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <button type="submit">Save Attendance</button>
      </form>
    </section>

    <section class="card">
      <h3>Recent Attendance Records</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Roll</th><th>Student</th><th>Status</th></tr></thead>
          <tbody>
            <% if (!records.length) { %>
              <tr><td colspan="4">No records yet.</td></tr>
            <% } %>
            <% records.forEach(r => { %>
              <tr>
                <td><%= r.date %></td>
                <td><%= r.roll_no %></td>
                <td><%= r.student_name %></td>
                <td><span class="<%= r.status === 'present' ? 'pill present' : 'pill absent' %>"><%= r.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
